{
  "name": "@tvmjs/client",
  "version": "1.0.0",
  "description": "TRON development node: serves the TRON HTTP REST API (/wallet/*) on top of the TVMJS execution stack.",
  "keywords": ["tron", "tvm", "client", "devnode", "rpc"],
  "homepage": "https://github.com/tronweb3/tvmjs-monorepo/tree/master/packages/client#readme",
  "bugs": {
    "url": "https://github.com/tronweb3/tvmjs-monorepo/issues?q=is%3Aissue+label%3A%22package%3A+client%22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tronweb3/tvmjs-monorepo.git"
  },
  "license": "MPL-2.0",
  "author": "TVMJS Team",
  "type": "module",
  "sideEffects": false,
  "main": "dist/cjs/index.js",
  "bin": {
    "tvmjs": "./bin/cli.mjs"
  },
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "typescript": "./src/index.ts",
        "default": "./dist/esm/index.js"
      },
      "require": "./dist/cjs/index.js"
    }
  },
  "files": ["dist", "src", "bin", "!dist/**/*.tsbuildinfo"],
  "scripts": {
    "start": "npx tsx --conditions=typescript bin/cli.ts",
    "biome": "npx @biomejs/biome check",
    "biome:fix": "npx @biomejs/biome check --write",
    "build": "../../config/cli/ts-build.sh",
    "clean": "../../config/cli/clean-package.sh",
    "coverage": "DEBUG=tvmjs npx vitest run -c ../../config/vitest.config.coverage.mts",
    "lint": "npm run biome && eslint --config ./eslint.config.mjs .",
    "lint:fix": "npm run biome:fix && eslint --fix --config ./eslint.config.mjs .",
    "prepublishOnly": "../../config/cli/prepublish.sh",
    "test": "npm run tsc && npm run test:node",
    "test:node": "npx vitest run -c ../../config/vitest.config.mts",
    "tsc": "../../config/cli/ts-compile.sh",
    "test:e2e": "npx tsx test/e2e/package.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tvmjs/block": "1.2.0",
    "@tvmjs/common": "1.2.0",
    "@tvmjs/statemanager": "1.2.0",
    "@tvmjs/tvm": "1.2.0",
    "@tvmjs/util": "1.2.0",
    "@tvmjs/vm": "1.2.0",
    "tronweb": "6.5.1"
  }
}
