{
  "name": "@tvmjs/statemanager",
  "version": "1.2.0",
  "description": "A state manager implementation for the TRON Virtual Machine (TVM).",
  "keywords": ["ethereum", "statemanager", "tron", "tvm"],
  "homepage": "https://github.com/tronweb3/tvmjs-monorepo/tree/master/packages/statemanager#readme",
  "bugs": {
    "url": "https://github.com/tronweb3/tvmjs-monorepo/issues?q=is%3Aissue+label%3A%22package%3A+statemanager%22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tronweb3/tvmjs-monorepo.git"
  },
  "license": "MPL-2.0",
  "author": "EthereumJS Team",
  "contributors": ["g11tech <gajinder@g11.in>", "TVMJS Team"],
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "typescript": "./src/index.ts",
        "default": "./dist/esm/index.js"
      },
      "require": "./dist/cjs/index.js"
    }
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "files": ["dist", "src"],
  "scripts": {
    "biome": "npx @biomejs/biome check",
    "biome:fix": "npx @biomejs/biome check --write",
    "build": "../../config/cli/ts-build.sh",
    "clean": "../../config/cli/clean-package.sh",
    "coverage": "DEBUG=tvmjs npx vitest run -c ../../config/vitest.config.coverage.mts",
    "coverage:istanbul": "DEBUG=tvmjs npx vitest run -c ../../config/vitest.config.coverage.istanbul.mts",
    "docs:build": "typedoc --options typedoc.mjs",
    "examples": "node --import tsx ../../scripts/examples-runner.ts -- statemanager",
    "examples:build": "npx embedme README.md",
    "lint": "npm run biome && eslint  --config ./eslint.config.mjs .",
    "lint:fix": "npm run biome:fix && eslint  --fix --config ./eslint.config.mjs .",
    "prepublishOnly": "../../config/cli/prepublish.sh",
    "test": "npm run test:node && npm run test:browser",
    "test:browser": "npx vitest run --config=./vitest.config.browser.mts",
    "test:node": "npx vitest run -c ../../config/vitest.config.mts",
    "tsc": "../../config/cli/ts-compile.sh"
  },
  "dependencies": {
    "@js-sdsl/ordered-map": "4.4.2",
    "@noble/hashes": "2.0.1",
    "@tvmjs/binarytree": "1.2.0",
    "@tvmjs/common": "1.2.0",
    "@tvmjs/mpt": "1.0.2",
    "@tvmjs/rlp": "1.0.0",
    "@tvmjs/util": "1.2.0",
    "debug": "4.4.0",
    "lru-cache": "11.0.2"
  },
  "devDependencies": {
    "@tvmjs/block": "1.2.0",
    "@tvmjs/testdata": "1.0.0",
    "@tvmjs/tvm": "1.2.0",
    "@tvmjs/tx": "1.2.0",
    "@tvmjs/vm": "1.2.0",
    "@types/debug": "4.1.12"
  }
}
