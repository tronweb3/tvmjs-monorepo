{
  "name": "@tvmjs/vm",
  "version": "1.2.0",
  "description": "A TRON Virtual Machine (TVM) implementation.",
  "keywords": ["ethereum", "VM", "tron", "tvm"],
  "homepage": "https://github.com/tronweb3/tvmjs-monorepo/tree/master/packages/vm#readme",
  "bugs": {
    "url": "https://github.com/tronweb3/tvmjs-monorepo/issues?q=is%3Aissue+label%3A%22package%3A+vm%22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tronweb3/tvmjs-monorepo.git"
  },
  "license": "MPL-2.0",
  "author": "EthereumJS Team",
  "contributors": ["mjbecze <mjbecze@gmail.com>", "Alex Beregszaszi <alex@rtfs.hu>", "TVMJS Team"],
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "typescript": "./src/index.ts",
        "default": "./dist/esm/index.js"
      },
      "require": "./dist/cjs/index.js"
    }
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "files": ["dist", "src"],
  "scripts": {
    "biome": "npx @biomejs/biome check",
    "biome:fix": "npx @biomejs/biome check --write",
    "build": "../../config/cli/ts-build.sh",
    "clean": "../../config/cli/clean-package.sh",
    "coverage": "DEBUG=tvmjs npx vitest run -c ./vitest.config.coverage.ts",
    "docs:build": "typedoc --options typedoc.mjs",
    "examples": "node --import tsx ../../scripts/examples-runner.ts -- vm",
    "examples:build": "npx embedme README.md",
    "fixtures:compile": "node --import tsx ./scripts/compile-contract-fixtures.ts",
    "lint": "npm run biome && eslint  --config ./eslint.config.mjs .",
    "lint:fix": "npm run biome:fix && eslint  --fix --config ./eslint.config.mjs .",
    "prepublishOnly": "../../config/cli/prepublish.sh",
    "test": "npm run test:API",
    "test:API": "npx vitest run -c ./vitest.config.ts ./test/api/",
    "test:browser": "npx vitest run --config=./vitest.config.browser.mts",
    "tsc": "../../config/cli/ts-compile.sh"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1",
    "@tvmjs/block": "1.2.0",
    "@tvmjs/common": "1.2.0",
    "@tvmjs/mpt": "1.0.2",
    "@tvmjs/rlp": "1.0.0",
    "@tvmjs/statemanager": "1.2.0",
    "@tvmjs/tvm": "1.2.0",
    "@tvmjs/tx": "1.2.0",
    "@tvmjs/util": "1.2.0",
    "debug": "4.4.0",
    "eventemitter3": "5.0.1"
  },
  "devDependencies": {
    "@noble/curves": "2.0.1",
    "@tvmjs/blockchain": "1.2.0",
    "@tvmjs/testdata": "1.0.0",
    "@types/debug": "4.1.12",
    "memory-level": "3.0.0",
    "solc": "0.8.33",
    "tronweb": "6.5.1",
    "viem": "2.55.10"
  },
  "engines": {
    "node": ">=20"
  }
}
