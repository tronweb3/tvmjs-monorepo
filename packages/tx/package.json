{
  "name": "@tvmjs/tx",
  "version": "1.2.0",
  "description": "Implementation of TRON transaction types for the TVM.",
  "keywords": ["ethereum", "transactions", "tron", "tvm"],
  "homepage": "https://github.com/tronweb3/tvmjs-monorepo/tree/master/packages/tx#readme",
  "bugs": {
    "url": "https://github.com/tronweb3/tvmjs-monorepo/issues?q=is%3Aissue+label%3A%22package%3A+tx%22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tronweb3/tvmjs-monorepo.git"
  },
  "license": "MPL-2.0",
  "author": "mjbecze <mb@ethdev.com>",
  "contributors": [
    {
      "name": "Alex Beregszaszi",
      "email": "alex@rtfs.hu",
      "url": "https://github.com/axic"
    },
    "TVMJS Team"
  ],
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "typescript": "./src/index.ts",
        "default": "./dist/esm/index.js"
      },
      "require": "./dist/cjs/index.js"
    }
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "files": ["dist", "src"],
  "scripts": {
    "biome": "npx @biomejs/biome check",
    "biome:fix": "npx @biomejs/biome check --write",
    "build": "../../config/cli/ts-build.sh",
    "clean": "../../config/cli/clean-package.sh",
    "coverage": "npx vitest run -c ../../config/vitest.config.coverage.mts",
    "docs:build": "typedoc --options typedoc.mjs",
    "examples": "node --import tsx ../../scripts/examples-runner.ts -- tx",
    "examples:build": "npx embedme README.md",
    "lint": "npm run biome && eslint  --config ./eslint.config.mjs .",
    "lint:fix": "npm run biome:fix && eslint  --fix --config ./eslint.config.mjs .",
    "prepublishOnly": "../../config/cli/prepublish.sh",
    "sc": "npm run spellcheck",
    "spellcheck": "npm run spellcheck:ts && npm run spellcheck:md",
    "spellcheck:md": "npx cspell --gitignore -c ../../config/cspell-md.json \"**.md\" --cache --show-suggestions --show-context",
    "spellcheck:ts": "npx cspell --gitignore -c ../../config/cspell-ts.json \"./**/*.ts\" --cache --show-suggestions --show-context",
    "test": "npm run test:node && npm run test:browser",
    "test:browser": "npx vitest run --config=./vitest.config.browser.mts",
    "test:node": "npm run test:node:api",
    "test:node:api": "npx vitest run -c ../../config/vitest.config.mts",
    "tsc": "../../config/cli/ts-compile.sh"
  },
  "dependencies": {
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1",
    "@tvmjs/common": "1.2.0",
    "@tvmjs/rlp": "1.0.0",
    "@tvmjs/util": "1.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
